{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david-aggeler/keel/vscode/schemas/test-bridge-config.schema.json",
  "title": "Keel Test Bridge Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command", "args", "displayName"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 5
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "discoveryMaxBufferBytes": {
      "description": "Optional per-workspace override of the discovery/desired-state stdout size bound, in bytes. Absent means the built-in 33554432-byte default. An out-of-range or non-integer value is rejected, never coerced.",
      "type": "integer",
      "minimum": 1024,
      "maximum": 536870912
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "boolean"
        },
        "lastRun": {
          "type": "boolean"
        },
        "desiredState": {
          "type": "boolean"
        },
        "findings": {
          "type": "boolean"
        },
        "ordinal": {
          "type": "boolean"
        }
      }
    }
  }
}
